{
  "name": "Coding Agent - Plan",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "coding-agent-plan",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "plan-webhook",
      "name": "Plan Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "coding-agent-plan"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'http://api:4000/runs/' + $('Plan Webhook').item.json.body.runId + '/stages/planner/execute'}}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "execute-planner-stage",
      "name": "Execute Planner Stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "planner-ok-condition",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "planner-ok",
      "name": "Planner OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'http://api:4000/runs/' + $('Plan Webhook').item.json.body.runId + '/actions/planner/wait'}}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ resumeUrl: $execution.resumeUrl, executionId: $execution.id, error: $('Execute Planner Stage').item.json.error }) }}",
        "options": {}
      },
      "id": "register-planner-wait",
      "name": "Register Planner Retry Wait",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "wait-planner-retry",
      "name": "Wait for Planner Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        960,
        160
      ],
      "webhookId": "wait-planner-retry"
    }
  ],
  "connections": {
    "Plan Webhook": {
      "main": [
        [
          {
            "node": "Execute Planner Stage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Planner Stage": {
      "main": [
        [
          {
            "node": "Planner OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Planner OK?": {
      "main": [
        [],
        [
          {
            "node": "Register Planner Retry Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Register Planner Retry Wait": {
      "main": [
        [
          {
            "node": "Wait for Planner Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Planner Retry": {
      "main": [
        [
          {
            "node": "Execute Planner Stage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "same-execution-plan-retry-v1",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
