# ---------- Platform ----------
NODE_ENV=development
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000
AGENT_INTERNAL_URL=http://agent-service:4100
RUNNER_INTERNAL_URL=http://runner:4200
N8N_PUBLIC_URL=http://localhost:5678
N8N_INTERNAL_URL=http://n8n:5678

# ---------- Database ----------
POSTGRES_DB=coding_agent
POSTGRES_USER=coding_agent
POSTGRES_PASSWORD=coding_agent_change_me
DATABASE_URL=postgresql://coding_agent:coding_agent_change_me@postgres:5432/coding_agent

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- n8n ----------
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_USER=admin
N8N_PASSWORD=change_me
# Optional for workflow auto-import via public API
N8N_API_KEY=

# ---------- LLM ----------
# Default keeps the exam requirement. You can replace provider/base URL/key/model later.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=luna-5.6-gpt
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=120000

# ---------- GitHub ----------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_DEFAULT_PRIVATE=true
GITHUB_AUTO_CREATE_REPO=false

# ---------- Agent limits ----------
MAX_FIX_ATTEMPTS=3
MAX_RUN_TIME_SECONDS=900
RUNNER_TIMEOUT_SECONDS=90
RUNNER_MEMORY_MB=512
RUNNER_CPUS=1

# ---------- Security ----------
INTERNAL_API_TOKEN=replace-me
